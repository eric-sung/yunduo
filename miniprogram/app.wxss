@font-face{font-family:"YD";font-weight:normal;src:url("data:font/woff;base64,")}
page{--p:#6C8CFF;--p2:#A48CFF;--hot:#FF7A59;--bg:#F4F7FF;--tx:#33406B;--mt:#8A93B5;
background:var(--bg);color:var(--tx);font-size:28rpx;font-family:"YD","PingFang SC","HarmonyOS Sans SC","Microsoft YaHei",sans-serif}
button{font-family:inherit}
.page{padding:24rpx}
.hero{position:relative;overflow:hidden;background:linear-gradient(135deg,#7FA2FF,#B69CFF);border-radius:36rpx;padding:40rpx 36rpx;color:#fff;display:flex;justify-content:space-between;align-items:center;box-shadow:0 12rpx 32rpx rgba(108,140,255,.3)}
.hero::before,.hero::after{content:"";position:absolute;background:rgba(255,255,255,.16);border-radius:50%}
.hero::before{width:200rpx;height:200rpx;right:-40rpx;top:-70rpx}.hero::after{width:140rpx;height:140rpx;left:30%;bottom:-70rpx}
.hero view,.hero button{position:relative;z-index:1}
.num{font-size:68rpx;margin-left:14rpx}
.sign{margin:0;background:#fff;color:var(--p);border-radius:40rpx;font-size:26rpx;line-height:2.3;padding:0 30rpx}
.sign.off{background:rgba(255,255,255,.3);color:#fff}
.sign::after,.share::after{border:none}
.tip{margin:20rpx 8rpx;color:var(--mt);font-size:24rpx}
.grid{display:flex;flex-wrap:wrap;justify-content:space-between}
.card{width:48.5%;background:#fff;border-radius:28rpx;padding:24rpx;margin-bottom:20rpx;box-sizing:border-box;box-shadow:0 8rpx 24rpx rgba(108,140,255,.1)}
.emoji{font-size:96rpx;text-align:center;background:linear-gradient(180deg,#EEF2FF,#fff);border-radius:20rpx;padding:12rpx 0}
.name{margin-top:12rpx;font-size:30rpx}
.meta{color:var(--mt);font-size:22rpx;margin:6rpx 0 14rpx}
.row{display:flex;justify-content:space-between;align-items:center}
.price{color:var(--hot);font-size:32rpx}
.buy{background:linear-gradient(135deg,#7FA2FF,#A48CFF);color:#fff;padding:8rpx 22rpx;border-radius:30rpx;font-size:22rpx}
.empty{text-align:center;color:#B6BDD8;margin-top:160rpx;line-height:2;white-space:pre-line}
.order,.box{background:#fff;border-radius:28rpx;padding:30rpx;margin-bottom:22rpx;box-shadow:0 8rpx 24rpx rgba(108,140,255,.08);line-height:1.8;white-space:pre-line}
.oh{display:flex;justify-content:space-between;align-items:center;font-size:32rpx}
.st{color:var(--p)}.st.done{color:#4CC38A}
.latest{margin:14rpx 0;color:#6B759B;font-size:26rpx}
.code{background:linear-gradient(135deg,#EEF2FF,#F4EEFF);border:2rpx dashed #9DB2FF;border-radius:20rpx;padding:22rpx;text-align:center;margin:16rpx 0;color:var(--mt)}
.code .c{font-size:60rpx;letter-spacing:8rpx;color:var(--p)}
.pick{background:linear-gradient(135deg,#7FA2FF,#A48CFF);color:#fff;border-radius:44rpx;text-align:center;padding:18rpx;margin-top:14rpx;box-shadow:0 8rpx 20rpx rgba(108,140,255,.3)}
.share{background:#EEF2FF;color:var(--p);border-radius:44rpx;font-size:26rpx;line-height:2.4;margin-top:12rpx}
.step{padding-left:28rpx;border-left:4rpx solid #D9E2FF;margin-left:8rpx;padding-bottom:16rpx;font-size:24rpx;color:#6B759B}
.step .t{color:#B6BDD8;font-size:22rpx}
.link{color:var(--mt);font-size:24rpx;text-align:right}
.search{display:flex;align-items:center;margin:22rpx 0}
.search input{flex:1;background:#fff;border-radius:44rpx;padding:16rpx 30rpx;font-size:26rpx;box-shadow:0 6rpx 18rpx rgba(108,140,255,.08)}
.cartbtn{position:relative;font-size:46rpx;margin-left:22rpx}
.badge{position:absolute;top:-8rpx;right:-14rpx;background:var(--hot);color:#fff;font-size:20rpx;border-radius:20rpx;padding:0 8rpx;line-height:30rpx}
.cats{white-space:nowrap;margin-bottom:18rpx}
.cat{display:inline-block;padding:10rpx 30rpx;margin-right:14rpx;border-radius:32rpx;background:#fff;color:var(--mt);font-size:26rpx}
.cat.on{background:linear-gradient(135deg,#7FA2FF,#A48CFF);color:#fff}
.bar{position:fixed;left:0;right:0;bottom:0;background:#fff;padding:20rpx 24rpx calc(20rpx + env(safe-area-inset-bottom));display:flex;justify-content:space-between;align-items:center;box-shadow:0 -6rpx 20rpx rgba(108,140,255,.1)}
.btn1,.btn2{padding:18rpx 44rpx;border-radius:44rpx;font-size:28rpx}
.btn1{background:linear-gradient(135deg,#FF9A6B,#FF7A59);color:#fff}.btn2{background:#EEF2FF;color:var(--p);margin:0 16rpx}
.sub{color:var(--mt);font-size:24rpx;margin-top:6rpx}
.b{font-size:32rpx}
.tag{background:#EEF2FF;color:var(--p);font-size:20rpx;padding:2rpx 12rpx;border-radius:8rpx;margin-left:8rpx}
.qty{display:flex;align-items:center}.qty text{padding:0 20rpx;font-size:34rpx}
.f{display:flex;align-items:center;padding:22rpx 0;border-bottom:1rpx solid #EDF0FA}
.f text{width:170rpx;color:var(--mt)}.f input,.f picker{flex:1}
.box .row{margin:8rpx 0}
.tp{padding-bottom:calc(170rpx + env(safe-area-inset-bottom)) !important}
