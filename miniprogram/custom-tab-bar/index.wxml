<view class="tb">
  <view class="ti" wx:for="{{list}}" wx:key="p" bindtap="sw" data-p="{{item.p}}">
    <view class="iw">
      <image class="ic" src="{{selected === index ? item.on : item.off}}" mode="aspectFit" />
      <text class="bd" wx:if="{{index === 1 && cartN}}">{{cartN}}</text>
      <text class="rd" wx:if="{{index === 2 && dot}}"></text>
    </view>
    <view class="tx {{selected === index ? 'on' : ''}}">{{item.t}}</view>
  </view>
</view>
