.tb{position:fixed;left:0;right:0;bottom:0;z-index:999;display:flex;background:#fff;height:98rpx;padding-bottom:env(safe-area-inset-bottom);box-shadow:0 -4rpx 16rpx rgba(108,140,255,.1);font-family:"YD","PingFang SC","HarmonyOS Sans SC","Microsoft YaHei",sans-serif}
.ti{flex:1;display:flex;flex-direction:column;align-items:center;justify-content:center}
.iw{position:relative;width:52rpx;height:52rpx}
.ic{width:52rpx;height:52rpx;display:block}
.tx{font-size:20rpx;color:#9AA3C7;margin-top:4rpx}.tx.on{color:#6C8CFF}
.bd{position:absolute;top:-10rpx;right:-22rpx;min-width:30rpx;height:30rpx;line-height:30rpx;padding:0 8rpx;box-sizing:border-box;border-radius:15rpx;background:#FF7A59;color:#fff;font-size:18rpx;text-align:center}
.rd{position:absolute;top:-4rpx;right:-6rpx;width:16rpx;height:16rpx;border-radius:50%;background:#FF7A59}
