<view class="page">
  <view class="box" style="text-align:center"><view style="font-size:120rpx">{{p.emoji}}</view><view class="b">{{p.name}}</view><view class="sub">{{p.station}}</view></view>
  <view class="box" wx:if="{{own}}">这是你自己的包裹，请回「包裹」页直接取件，或分享给朋友帮忙。</view>
  <view class="box" wx:else>
    <view class="sub">朋友请你帮忙取件，取件码：</view>
    <view class="code"><view class="c">{{p.code}}</view></view>
    <block wx:if="{{!done}}">
      <input type="nickname" placeholder="给自己起个名字（选填）" value="{{nick}}" bindinput="onNick" style="background:#FFF7F0;border-radius:16rpx;padding:16rpx 20rpx;margin-bottom:16rpx" />
      <view class="pick" bindtap="help">我来帮TA取件</view>
    </block>
    <block wx:else>
      <view class="latest">✅ 取件成功{{got ? '，获得 ' + got + ' 云朵币谢礼' : ''}}</view>
      <button class="share" open-type="share">📮 告诉朋友已经取到啦</button>
    </block>
  </view>
</view>
