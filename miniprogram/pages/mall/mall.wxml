<view class="page tp">
  <view class="hero">
    <view>云朵币余额<text class="num">{{balance}}</text></view>
    <button class="sign {{signed ? 'off' : ''}}" bindtap="onSign">{{signed ? '已签到 · 连续' + streak + '天' : '签到领云朵币'}}</button>
  </view>
  <view class="adwrap">
    <ad wx:if="{{bannerOn}}" unit-id="{{bannerId}}" ad-intervals="60" binderror="onAdErr" />
    <swiper wx:else class="bn" autoplay circular interval="4000" indicator-dots indicator-color="rgba(255,255,255,.5)" indicator-active-color="#fff">
      <swiper-item wx:for="{{banners}}" wx:key="t" bindtap="onBanner" data-a="{{item.a}}">
        <view class="bi b{{index}}"><view><view class="bt">{{item.t}}</view><view class="bs">{{item.s}}</view></view><text class="be">{{item.e}}</text></view>
      </swiper-item>
    </swiper>
    <text class="adtag">广告</text>
  </view>
  <view class="search"><input placeholder="🔍 搜索想要的宝贝" bindinput="onSearch" /></view>
  <scroll-view scroll-x class="cats"><view class="cat {{cat === item ? 'on' : ''}}" wx:for="{{cats}}" wx:key="*this" bindtap="onCat" data-c="{{item}}">{{item}}</view></scroll-view>
  <view class="sorts">
    <text class="so {{sort === 'def' ? 'on' : ''}}" bindtap="onSort" data-s="def">综合</text>
    <text class="so {{sort === 'sales' ? 'on' : ''}}" bindtap="onSort" data-s="sales">销量</text>
    <text class="so {{sort === 'pa' || sort === 'pd' ? 'on' : ''}}" bindtap="onSort" data-s="price">价格{{sort === 'pa' ? ' ↑' : sort === 'pd' ? ' ↓' : ''}}</text>
    <text class="cnt">共 {{goods.length}} 件</text>
  </view>
  <view class="empty" wx:if="{{!goods.length}}">没有找到相关商品</view>
  <view class="grid">
    <view class="gc" wx:for="{{goods}}" wx:key="id" bindtap="goDetail" data-id="{{item.id}}">
      <view class="gi c{{item.ci % 8}}"><text class="ge">{{item.emoji}}</text><text class="gt" wx:if="{{item.tag}}">{{item.tag}}</text></view>
      <view class="gb">
        <view class="gn">{{item.name}}</view>
        <view class="gd">{{item.desc}}</view>
        <view class="gp"><text class="gpn">{{item.price}}</text><text class="gpu">云朵币</text><text class="gpo">{{item.orig}}</text></view>
        <view class="gm"><text>已售 {{item.sales}}+</text><text>约 {{item.days}} 天达</text></view>
      </view>
    </view>
  </view>
  <view class="end" wx:if="{{goods.length}}">— 已经到底啦 ☁️ —</view>
</view>
