<view class="top">
  <view class="cl c1"></view><view class="cl c2"></view>
  <view class="user">
    <view class="avatar">☁️</view>
    <view class="uinfo" bindtap="editNick"><view class="nick">{{nick}} ✎</view><view class="lv">{{lv}}</view></view>
    <view class="signbtn {{signed ? 'off' : ''}}" bindtap="onSign">{{signed ? '已签到' : '签到'}}</view>
  </view>
  <view class="stats">
    <view class="s"><view class="n">{{d.balance}}</view><view class="l">云朵币</view></view>
    <view class="s"><view class="n">{{d.streak}}</view><view class="l">连续签到(天)</view></view>
    <view class="s"><view class="n">{{cnt}}</view><view class="l">累计包裹</view></view>
  </view>
</view>
<view class="wrap tp">
  <view class="panel adp">
    <view style="flex:1"><view class="adt">🎬 看视频领云朵币</view><view class="sub">每次 +{{adGain}}，今日还可领 {{adLeft}} 次</view></view>
    <view class="adb {{adLeft ? '' : 'off'}}" bindtap="watchAd">{{adLeft ? '去观看' : '明天再来'}}</view>
  </view>
  <view class="panel">
    <view class="ph"><text>我的包裹</text><text class="more" bindtap="goOrders">全部 ›</text></view>
    <view class="st4">
      <view class="it" wx:for="{{stList}}" wx:key="k" bindtap="goOrders" data-k="{{item.k}}"><view class="ico">{{item.i}}<text class="dot" wx:if="{{item.n}}">{{item.n}}</text></view><view>{{item.k}}</view></view>
    </view>
  </view>
  <view class="panel">
    <view class="ph"><text>签到日历</text><text class="more">每天来领云朵币</text></view>
    <view class="days">
      <view class="day {{item.on ? 'on' : ''}}" wx:for="{{days}}" wx:key="n"><view class="dc">{{item.on ? '☁️' : '+' + item.gain}}</view><view class="dn">第{{item.n}}天</view></view>
    </view>
  </view>
  <view class="panel menu">
    <view class="mi" bindtap="go" data-url="/pages/address/address"><text>📍 收货地址</text><text class="ar">›</text></view>
    <view class="mi" bindtap="about"><text>🎈 关于云朵</text><text class="ar">›</text></view>
  </view>
  <view class="link" style="text-align:center;margin:30rpx 0 40rpx" bindtap="onReset">重置数据</view>
</view>
