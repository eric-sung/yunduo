<view class="page">
  <view class="box">
    <view class="f"><text>收件人</text><input value="{{a.name}}" placeholder="姓名" bindinput="inp" data-k="name" /></view>
    <view class="f"><text>手机号</text><input type="number" maxlength="11" value="{{a.phone}}" placeholder="11位手机号" bindinput="inp" data-k="phone" /></view>
    <view class="f"><text>所在地区</text><picker mode="region" bindchange="reg"><view>{{a.region.length ? a.region[0]+' '+a.region[1]+' '+a.region[2] : '请选择 省/市/区'}}</view></picker></view>
    <view class="f"><text>详细地址</text><input value="{{a.detail}}" placeholder="街道、楼栋、门牌号" bindinput="inp" data-k="detail" /></view>
    <view class="f"><text>设为默认</text><switch checked="{{a.isDefault}}" bindchange="def" color="#FF6B3D" /></view>
  </view>
  <view class="pick" bindtap="save">保存</view>
  <view class="link" style="text-align:center;margin-top:30rpx" wx:if="{{editing}}" bindtap="del">删除地址</view>
</view>
