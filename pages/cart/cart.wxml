<view class="page" style="padding-bottom:160rpx">
  <view class="empty" wx:if="{{!list.length}}">购物车空空如也\n去商城挑点好东西吧 🛍</view>
  <view class="box" wx:for="{{list}}" wx:key="id">
    <view class="row"><text>{{item.g.emoji}} {{item.g.name}}</text><text class="price">{{item.g.price}}币</text></view>
    <view class="row" style="margin-top:12rpx"><text class="sub">约 {{item.g.days}} 天送达</text>
      <view class="qty"><text bindtap="chg" data-id="{{item.id}}" data-d="-1">－</text><text>{{item.n}}</text><text bindtap="chg" data-id="{{item.id}}" data-d="1">＋</text></view></view>
  </view>
  <view class="bar" wx:if="{{list.length}}"><text>合计 <text class="price">{{total}}</text> 云朵币</text><view class="btn1" bindtap="go">去结算</view></view>
</view>
