<view class="page" style="padding-bottom:160rpx">
  <view class="box" bindtap="pickAddr">
    <block wx:if="{{addr}}"><view><text class="b">{{addr.name}}</text>　{{addr.phone}}</view><view class="sub">{{addr.text}}</view></block>
    <view wx:else class="st">＋ 请选择收货地址</view>
  </view>
  <view class="box"><view class="row" wx:for="{{items}}" wx:key="id"><text>{{item.g.emoji}} {{item.g.name}} ×{{item.n}}</text><text>{{item.g.price * item.n}}币</text></view></view>
  <view class="box row"><text>预计送达</text><text>{{days}} 天后到驿站</text></view>
  <view class="bar"><text>合计 <text class="price">{{total}}</text>（余额 {{balance}}）</text><view class="btn1" bindtap="submit">提交订单</view></view>
</view>
