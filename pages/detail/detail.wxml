<view class="dp">
  <swiper class="gal" circular bindchange="onSw">
    <swiper-item wx:for="{{slides}}" wx:key="t"><view class="slide s{{index}}"><text class="se">{{g.emoji}}</text><text class="sc">{{item.t}}</text></view></swiper-item>
  </swiper>
  <view class="ind">{{cur + 1}}/3</view>

  <view class="pbox">
    <view class="pr"><text class="pn">{{price}}</text><text class="pu">云朵币</text><text class="po">{{d.orig}}</text><text class="ps">已售 {{d.sales}}+</text></view>
    <view class="tags"><text class="tg" wx:for="{{d.tags}}" wx:key="*this">{{item}}</text></view>
  </view>
  <view class="box"><view class="ttl">{{g.name}}</view><view class="sub">{{g.desc}}</view></view>

  <view class="box info">
    <view class="ir" bindtap="openSheet" data-s="cpn"><text class="ik">优惠券</text><view class="iv"><text class="cp" wx:for="{{coupons}}" wx:key="id">满{{item.min}}减{{item.off}}</text></view><text class="ar">领取 ›</text></view>
    <view class="ir" bindtap="openSheet" data-s="spec"><text class="ik">已选</text><view class="iv">{{specText}} × {{qty}}</view><text class="ar">›</text></view>
    <view class="ir" bindtap="goAddr"><text class="ik">配送至</text><view class="iv">{{addr || '请选择收货地址'}}</view><text class="ar">›</text></view>
    <view class="ir"><text class="ik">发货</text><view class="iv">虚拟快递 · 下单后约 {{g.days}} 天到驿站</view></view>
    <view class="ir"><text class="ik">服务</text><view class="iv">✓ 云朵严选　✓ 极速发货　✓ 7天无理由</view></view>
  </view>

  <view class="box">
    <view class="hd"><text>用户评价（{{revN}}）</text><text class="more">好评率 98% ›</text></view>
    <view class="rv" wx:for="{{d.reviews}}" wx:key="n">
      <view class="rh"><text class="rn">☁️ {{item.n}}</text><text class="star">{{item.s === 5 ? '★★★★★' : '★★★★☆'}}</text></view>
      <view>{{item.t}}</view><view class="sub">规格：{{item.spec}}</view>
    </view>
  </view>

  <view class="box">
    <view class="hd"><text>商品参数</text></view>
    <view class="pm" wx:for="{{d.params}}" wx:key="*this"><text class="pk">{{item[0]}}</text><text class="pv">{{item[1]}}</text></view>
  </view>

  <view class="box">
    <view class="hd"><text>图文详情</text></view>
    <view class="big"><text>{{g.emoji}}</text></view>
    <view class="pt" wx:for="{{d.pts}}" wx:key="*this"><text class="pi">{{index + 1}}</text>{{item}}</view>
    <view class="big sm"><text>{{g.emoji}}{{g.emoji}}</text></view>
    <view class="sub" style="text-align:center">—— 以上均为虚拟商品展示，仅供娱乐 ——</view>
  </view>

  <view class="bar">
    <view class="cartbtn" bindtap="goCart">🛒<text class="badge" wx:if="{{cartN}}">{{cartN}}</text></view>
    <view style="display:flex"><view class="btn2" bindtap="openSheet" data-s="spec" data-m="cart">加入购物车</view><view class="btn1" bindtap="openSheet" data-s="spec" data-m="buy">立即购买</view></view>
  </view>

  <view class="mask" wx:if="{{sheet}}" bindtap="close"></view>
  <view class="sheet" wx:if="{{sheet === 'spec'}}">
    <view class="sh"><view class="thumb2">{{g.emoji}}</view><view style="flex:1"><view class="price" style="font-size:40rpx">{{price}} 云朵币</view><view class="sub">已选：{{specText}}</view></view><text class="x" bindtap="close">✕</text></view>
    <view class="grp" wx:for="{{d.groups}}" wx:for-item="gp" wx:for-index="gi" wx:key="n">
      <view class="gn">{{gp.n}}</view>
      <view class="opts"><view class="opt {{sel[gi] === oi ? 'on' : ''}}" wx:for="{{gp.o}}" wx:for-item="op" wx:for-index="oi" wx:key="t" bindtap="pick" data-gi="{{gi}}" data-oi="{{oi}}">{{op.t}}<text wx:if="{{op.d}}"> +{{op.d}}</text></view></view>
    </view>
    <view class="row" style="margin:24rpx 0"><text class="gn">数量</text><view class="qty"><text bindtap="qty" data-d="-1">－</text><text>{{qty}}</text><text bindtap="qty" data-d="1">＋</text></view></view>
    <view class="btn1 wide" bindtap="ok">{{mode === 'cart' ? '加入购物车' : mode === 'buy' ? '立即购买' : '确定'}}</view>
  </view>
  <view class="sheet" wx:if="{{sheet === 'cpn'}}">
    <view class="sh"><view style="flex:1;font-size:34rpx">领取优惠券</view><text class="x" bindtap="close">✕</text></view>
    <view class="cpn" wx:for="{{coupons}}" wx:key="id">
      <view class="cl"><text class="off">{{item.off}}</text><text class="sub" style="color:#fff">满{{item.min}}可用</text></view>
      <view class="cr"><view>{{item.t}}</view><view class="sub">结算时自动选用最优券</view></view>
      <view class="cg {{item.got ? 'got' : ''}}" bindtap="claim" data-id="{{item.id}}">{{item.got ? '已领取' : '领取'}}</view>
    </view>
  </view>
</view>
