<view class="page" style="padding-bottom:160rpx">
  <view class="box" style="text-align:center"><view style="font-size:200rpx">{{g.emoji}}</view></view>
  <view class="box">
    <view class="price" style="font-size:44rpx">{{g.price}} 云朵币</view>
    <view class="name" style="font-size:34rpx">{{g.name}}</view>
    <view class="sub">{{g.desc}}</view>
  </view>
  <view class="box"><view class="row"><text>分类</text><text>{{g.cat}}</text></view><view class="row"><text>配送</text><text>虚拟快递 · 约 {{g.days}} 天到驿站</text></view><view class="row"><text>服务</text><text>只花云朵币，不花真钱 ✓</text></view></view>
  <view class="bar">
    <view class="cartbtn" bindtap="goCart">🛒<text class="badge" wx:if="{{cartN}}">{{cartN}}</text></view>
    <view class="btn2" bindtap="addCart">加入购物车</view><view class="btn1" bindtap="buyNow">立即购买</view>
  </view>
</view>
