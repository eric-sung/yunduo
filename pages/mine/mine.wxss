.top{position:relative;overflow:hidden;background:linear-gradient(160deg,#7FA2FF,#B69CFF);padding:40rpx 32rpx 90rpx;color:#fff;border-radius:0 0 56rpx 56rpx}
.cl{position:absolute;background:rgba(255,255,255,.15);border-radius:50%}
.c1{width:260rpx;height:260rpx;right:-60rpx;top:-80rpx}.c2{width:180rpx;height:180rpx;left:-50rpx;bottom:-60rpx}
.user{position:relative;display:flex;align-items:center}
.avatar{width:120rpx;height:120rpx;border-radius:50%;background:#fff;font-size:68rpx;text-align:center;line-height:120rpx;box-shadow:0 8rpx 20rpx rgba(80,90,180,.25)}
.uinfo{flex:1;margin-left:24rpx}.nick{font-size:38rpx}
.lv{display:inline-block;margin-top:8rpx;background:rgba(255,255,255,.25);border-radius:24rpx;padding:2rpx 20rpx;font-size:22rpx}
.signbtn{background:#fff;color:#6C8CFF;border-radius:40rpx;padding:12rpx 32rpx;font-size:26rpx}
.signbtn.off{background:rgba(255,255,255,.3);color:#fff}
.stats{position:relative;display:flex;margin-top:44rpx}
.s{flex:1;text-align:center}.n{font-size:56rpx}.l{font-size:22rpx;opacity:.85}
.wrap{padding:0 24rpx;margin-top:-56rpx;position:relative}
.panel{background:#fff;border-radius:32rpx;padding:28rpx;margin-bottom:22rpx;box-shadow:0 8rpx 28rpx rgba(108,140,255,.12)}
.ph{display:flex;justify-content:space-between;align-items:center;font-size:32rpx;margin-bottom:22rpx}
.more{color:#8A93B5;font-size:22rpx}
.st4{display:flex}.it{flex:1;text-align:center;font-size:24rpx;color:#6B759B}
.ico{position:relative;display:inline-block;width:92rpx;height:92rpx;line-height:92rpx;border-radius:28rpx;background:#EEF2FF;font-size:46rpx;margin-bottom:8rpx}
.dot{position:absolute;top:-8rpx;right:-8rpx;min-width:32rpx;height:32rpx;line-height:32rpx;border-radius:16rpx;background:#FF7A59;color:#fff;font-size:20rpx;text-align:center}
.days{display:flex;justify-content:space-between}.day{text-align:center}
.dc{width:76rpx;height:76rpx;line-height:76rpx;border-radius:50%;background:#F1F4FF;color:#8A93B5;font-size:22rpx;margin:0 auto 8rpx}
.day.on .dc{background:linear-gradient(135deg,#7FA2FF,#A48CFF);font-size:36rpx}
.dn{font-size:20rpx;color:#B0B8D4}
.menu{padding:8rpx 28rpx}
.mi{display:flex;justify-content:space-between;padding:28rpx 0;border-bottom:1rpx solid #EDF0FA;font-size:30rpx}
.mi:last-child{border:none}.ar{color:#B0B8D4}
