.seg{position:sticky;top:0;z-index:9;display:flex;background:#fff;padding:12rpx 12rpx 0;box-shadow:0 6rpx 16rpx rgba(108,140,255,.08)}
.sg{flex:1;position:relative;text-align:center;padding:20rpx 0 22rpx;color:#8A93B5;font-size:28rpx}
.sg.on{color:#6C8CFF}.sg.on::after{content:"";position:absolute;left:30%;right:30%;bottom:6rpx;height:6rpx;border-radius:6rpx;background:linear-gradient(90deg,#7FA2FF,#A48CFF)}
.cn{margin-left:6rpx;background:#FF7A59;color:#fff;font-size:18rpx;border-radius:16rpx;padding:0 8rpx;vertical-align:top}
.oc{background:#fff;border-radius:32rpx;padding:28rpx;margin-bottom:24rpx;box-shadow:0 8rpx 28rpx rgba(108,140,255,.1)}
.oh2{display:flex;justify-content:space-between;align-items:center;margin-bottom:20rpx}
.oid{color:#B0B8D4;font-size:24rpx}
.chip{font-size:22rpx;padding:4rpx 20rpx;border-radius:24rpx}
.chip.wait{background:#FFF3E0;color:#F29A2E}.chip.go{background:#EEF2FF;color:#6C8CFF}.chip.pick{background:#FFE8E1;color:#FF7A59}.chip.done{background:#E3F8EE;color:#35B27C}
.main{display:flex;align-items:center}
.thumb{width:128rpx;height:128rpx;line-height:128rpx;text-align:center;font-size:56rpx;border-radius:28rpx;background:linear-gradient(135deg,#EEF2FF,#F4EEFF);flex-shrink:0}
.info{margin-left:24rpx}.nm{font-size:32rpx}
.prog{margin:22rpx 0 6rpx}
.pb{height:12rpx;border-radius:12rpx;background:#EDF0FA;overflow:hidden;margin-bottom:8rpx}
.pf{height:100%;border-radius:12rpx;background:linear-gradient(90deg,#7FA2FF,#A48CFF)}
.pf.wait{background:#FFC97A}.pf.pick{background:linear-gradient(90deg,#FF9A6B,#FF7A59)}
.ticket{display:flex;align-items:center;margin:20rpx 0 8rpx;padding:22rpx 24rpx;border-radius:24rpx;background:linear-gradient(135deg,#EEF2FF,#F7F0FF);border:2rpx dashed #9DB2FF}
.tl{flex:1}.tc{font-size:50rpx;letter-spacing:6rpx;color:#6C8CFF;margin-top:4rpx}
.tr{display:flex;flex-direction:column;align-items:stretch}
.tr .share{margin:0 0 12rpx;padding:0 28rpx;line-height:2.2;font-size:24rpx}
.pk{background:linear-gradient(135deg,#FF9A6B,#FF7A59);color:#fff;border-radius:40rpx;text-align:center;padding:10rpx 28rpx;font-size:24rpx}
.go{display:inline-block;margin-top:24rpx;background:linear-gradient(135deg,#7FA2FF,#A48CFF);color:#fff;border-radius:40rpx;padding:14rpx 44rpx;font-size:26rpx}
